module signer_manager_module {
  version "0.1.0"
  depends []

  method configure(config_json: tstr) -> tstr description "Name the roles and the signer modules consulted: `{ approvers?, custodians?, signers? }` →\n`{ ok, approvers, custodians, signers }`. TOTAL — what the document doesn't name is held by\nnobody — and effective at once. UNGATED for now, as keystore_module's: see docs/specs.md."
  method request_approval(intent_json: tstr) -> tstr description "Ask a person to approve signing; returns at once with `{ ok, handle, receipt, state }`.\nThe handle is announced on the event plane; the receipt, returned once, authorises collecting."
  method approval_status(handle: tstr, receipt: tstr) -> tstr description "`{ ok, state, reason? }`: offered, rendered, signing or settled. Never the intent or results."
  method fetch_result(handle: tstr, receipt: tstr) -> tstr description "`{ ok, signed: [...] }`, idempotent until `ack_result`."
  method ack_result(handle: tstr, receipt: tstr) -> bool description "The requester has the results; erase them."
  method cancel_approval(handle: tstr, receipt: tstr) -> bool description "The requester gave up; a signer still working is told to stop."
  method pending() -> tstr description "Queue summaries, never leg detail: `{ ok, pending: [{ handle, requester, state, purpose,\nlegs, ageMs, error? }] }`."
  method acknowledge(handle: tstr) -> tstr description "Claim a request for display: `{ ok, handle, bundle_id, requester, claim_lines,\nrender_lines, signer, collects, account, unlocked }`. `collects` says what `approve` must carry,\nunless `unlocked`, when an unlock covers the request and no password is needed."
  method approve(handle: tstr, bundle_id: tstr, password: tstr) -> tstr description "The person said yes: `{ ok, signed_count }` once signed, or `{ ok, state: \"signing\" }` while a\ndevice works. A wrong password answers `{ ok: false, code: \"wrong_secret\" }` and the request\nstays on screen. `password` is the vault password or a card's PIN, or empty."
  method reject(handle: tstr) -> bool description "The person said no."
  method request_open(params_json: tstr) -> tstr description "Ask a person to open a Bitcoin wallet for the caller: `{ group, network? }` to reopen one, or\n`{ family, network }` to let the person pick, create or restore one, with optional `unlock`\nterms and a `reason` → `{ ok, handle, receipt, state }`. `fetch_result` then returns `{ ok,\nresult: { group, family, chain, network, external, internal, fingerprint, databaseKey, origin,\nbirthday, unlocked } }`. Tier B."
  method request_unlock(params_json: tstr) -> tstr description "Ask for an account to stay unlocked: `{ account, ttlMs?, count?, apps?, confirm?, reason? }`\n→ `{ ok, handle, receipt, state }`. The person decides the terms. Tier B."
  method access_requests() -> tstr description "The custodian's queue: `{ ok, requests: [{ handle, requester, kind, state, ageMs }] }`. Tier D."
  method acknowledge_access(handle: tstr) -> tstr description "Claim one for display: `{ ok, handle, requester, kind, bundle_id, lines, asked }`. `asked` is\n`{ group, family, network, unlock }` for an open and `{ account, terms }` for an unlock. Tier D."
  method approve_access(params_json: tstr) -> tstr description "The person decided: `{ handle, bundle_id, group?, password, unlock?, birthday? }` → `{ ok }`,\nor `{ ok: false, code: \"wrong_secret\" }` with the request left on screen. For a device\naccount the password is its database key's, set at its first open with the `birthday`. Tier D."
  method reject_access(handle: tstr) -> bool description "The person said no. Tier D."
  method account_descriptors(group: tstr) -> tstr description "An open wallet's descriptors again: `{ ok, group, external, internal }`, only for a module\nthe wallet is open for."
  method close_account(params_json: tstr) -> tstr description "Close a wallet: `{ group }` for the caller's own, or as the custodian `{ group, module }` →\n`{ ok, closed }`. An unlock scoped to that module alone ends with it."
  method open_accounts() -> tstr description "Every open wallet and its module: `{ ok, open: [{ module, group }] }`. Tier D."
  method unlock(params_json: tstr) -> tstr description "The person's own unlock, from the keys app: `{ account, password, ttlMs?, count?, apps,\nconfirm? }` → `{ ok, account, expiresInMs, countLeft }`. Tier D."
  method lock(params_json: tstr) -> tstr description "`{ account? }`, every account for `{}` → `{ ok, locked }`. Tier D."
  method unlocked() -> tstr description "`{ ok, unlocked: [{ account, expiresInMs, countLeft, apps, confirm }] }`. Approver and custodian."
  method unattended_signatures() -> tstr description "Requests signed without being shown: `{ ok, signed: [{ handle, requester, account, ageMs }] }`.\nApprover and custodian."
  method accounts() -> tstr description "Every signer's accounts, each under the first signer that offers it: `{ ok, accounts: [{\nid, family, chain?, address?, label?, signer, available }] }`. No xpub: it would show a\nBitcoin wallet's whole history to anyone who asked."
  method signers() -> tstr description "The signer modules consulted, with what each says it is: `{ ok, signers: [{ name, info? }] }`."
  method caller_identity() -> tstr description "What this module sees as its caller, with the roles and signers in force:\n`{ ok, kind, identity, approvers, custodians, signers }`."

  event approval_offered(handle: tstr) description "A new request is waiting."
  event approval_settled(handle: tstr, state: tstr) description "A request reached a terminal state."
  event approval_progress(handle: tstr, state: tstr) description "A request moved without settling, such as to `signing`."
  event accounts_changed(count: int) description "A signer's accounts changed; re-read `accounts`. `count` is advisory."
  event access_requested(handle: tstr) description "An open or unlock request is waiting for the custodian."
  event access_settled(handle: tstr, state: tstr) description "An open or unlock request reached a terminal state."
  event unlock_changed(account: tstr) description "An account was unlocked or locked."
  event signed_without_asking(handle: tstr) description "A request was signed without being shown, inside an unlock that allows it."
}
