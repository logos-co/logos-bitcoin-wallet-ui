module signer_manager_module {
  version "0.1.0"
  depends []

  method configure(config_json: tstr) -> tstr description "Name the roles and the signer modules consulted: `{ approvers?, custodians?, signers? }` →\n`{ ok, approvers, custodians, signers }`. TOTAL — what the document doesn't name is held by\nnobody — and effective at once. UNGATED for now, as keystore_module's: see docs/specs.md."
  method request_approval(intent_json: tstr) -> tstr description "Ask a person to approve signing; returns at once with `{ ok, handle, receipt, state }`.\nThe handle is announced on the event plane; the receipt, returned once, authorises collecting."
  method approval_status(handle: tstr, receipt: tstr) -> tstr description "`{ ok, state, reason? }`: offered, rendered, signing or settled. Never the intent or results."
  method fetch_result(handle: tstr, receipt: tstr) -> tstr description "`{ ok, signed: [...] }`, idempotent until `ack_result`."
  method ack_result(handle: tstr, receipt: tstr) -> bool description "The requester has the results; erase them."
  method cancel_approval(handle: tstr, receipt: tstr) -> bool description "The requester gave up; a signer still working is told to stop."
  method roster() -> tstr description "Every account once, with every signer that holds it, ranked: `{ ok, accounts: [{ key,\nfamily, chain?, address?, path?, label?, labels?, wallet?: { fingerprint?, name? }, holders:\n[{ signer, accountId, kind, model, transport, presence, available, collects, showsRequest,\nrequestKinds }] }] }`. No xpub."
  method pending() -> tstr description "Queue summaries, never leg detail: `{ ok, pending: [{ handle, requester, state, purpose,\nlegs, ageMs, error? }] }`."
  method acknowledge(handle: tstr) -> tstr description "Claim a request for display: `{ ok, handle, bundle_id, requester, claim_lines,\nrender_lines, signer, collects, account, unlocked, signers, explicit }`. `collects` says what\n`approve` must carry, unless `unlocked`, when an unlock covers the request and no password is\nneeded. `signers` are every holder of the account, ranked, as `{ signer, accountId, kind,\nmodel, transport, presence, available, collects, showsRequest, canTake, why? }`; `signer` is\nthe one it goes to, chosen by the person when `explicit`."
  method choose_signer(handle: tstr, bundle_id: tstr, signer: tstr) -> tstr description "The person chose which holder signs the request on screen: the `acknowledge` reply for it.\nThe request and its commitment don't change."
  method approval_signers(handle: tstr) -> tstr description "The `acknowledge` reply again, as the holders stand now: after a signer's accounts change."
  method approve(handle: tstr, bundle_id: tstr, password: tstr) -> tstr description "The person said yes: `{ ok, signed_count }` once signed, or `{ ok, state: \"signing\" }` while a\ndevice works. A wrong password answers `{ ok: false, code: \"wrong_secret\" }` and the request\nstays on screen. `password` is the vault password or a card's PIN, or empty."
  method reject(handle: tstr) -> bool description "The person said no."
  method request_open(params_json: tstr) -> tstr description "Ask a person to open a Bitcoin wallet for the caller: `{ group, network?, seed? }` to reopen\none (`seed` names it while its seed is locked), or `{ family, network }` to let the person\npick, create or restore one, with optional `unlock` terms and a `reason` → `{ ok, handle,\nreceipt, state }`. Given in the Signer app, `fetch_result` returns `{ ok, result: { group,\nfamily, chain, network, external, internal, fingerprint, seed, origin?, birthday? } }`, and\nthe caller takes its database key from `data_key`. The keys app's older path returns a\n`databaseKey` and `unlocked` instead of `seed`. Tier B."
  method request_unlock(params_json: tstr) -> tstr description "Ask for an account to stay unlocked: `{ account, ttlMs?, count?, apps?, confirm?, reason? }`\n→ `{ ok, handle, receipt, state }`. The person decides the terms. Tier B."
  method access_requests() -> tstr description "The queue: `{ ok, requests: [{ handle, requester, kind, state, ageMs, seed }] }`, `seed` the\nwallet an open names when known; an approver sees opens only. Approvers and the custodian."
  method acknowledge_access(handle: tstr) -> tstr description "Claim one for display: `{ ok, handle, requester, kind, bundle_id, lines, asked, seed }`.\n`asked` is `{ group, family, network, unlock, seed }` for an open and `{ account, terms }` for\nan unlock; `seed` is the named wallet's. The first app to claim it keeps it."
  method approve_access(params_json: tstr) -> tstr description "The person decided: an approver's consent `{ handle, bundle_id, group? }`, once the wallet is\nunlocked (`code: locked` until then), or the custodian's `{ handle, bundle_id, group?,\npassword, unlock?, birthday? }` → `{ ok }`, or `{ ok: false, code }` with the request left on\nscreen."
  method reject_access(handle: tstr) -> bool description "The person said no: the app that claimed it."
  method account_descriptors(group: tstr) -> tstr description "An open wallet's descriptors again: `{ ok, group, external, internal }`, only for a module\nthe wallet is open for."
  method close_account(params_json: tstr) -> tstr description "Close a wallet: `{ group }` for the caller's own, or as the custodian `{ group, module }` →\n`{ ok, closed }`. An unlock scoped to that module alone ends with it."
  method open_accounts() -> tstr description "Every open wallet and its module: `{ ok, open: [{ module, group }] }`. Tier D."
  method unlock(params_json: tstr) -> tstr description "The person's own unlock, from the keys app: `{ account, password, ttlMs?, count?, apps,\nconfirm? }` → `{ ok, account, expiresInMs, countLeft }`. Tier D."
  method lock(params_json: tstr) -> tstr description "`{ account? }`, every account for `{}` → `{ ok, locked }`. Tier D."
  method unlocked() -> tstr description "`{ ok, unlocked: [{ account, expiresInMs, countLeft, apps, confirm }] }`. Approver and custodian."
  method unattended_signatures() -> tstr description "Requests signed without being shown: `{ ok, signed: [{ handle, requester, account, ageMs }] }`.\nApprover and custodian."
  method wallets() -> tstr description "Every wallet: `{ ok, wallets: [{ seed, name, locked, kinds, privateName? }] }`. Tier B."
  method data_key(params_json: tstr) -> tstr description "The caller's own key for a wallet's data: `{ seed, scope, generation? }`, `seed` a wallet's\nor `\"profile\"` → `{ ok, key, generation }`, or `code: locked`. Tier B: a module gets only\nkeys of its own."
  method enroll_seed(params_json: tstr) -> tstr description "A signer registers the seed it just added, with the holder's unlock key at index 0 when it\ngives one: `{ seed, kind, unlockKey?, name, origin?, birthday? }` → `{ ok, seed, new,\nunlocked }`. `seed` in is the signer's own name for it. The configured signers only."
  method wallet_settings() -> tstr description "The Signer app's view: `{ ok, wallets: [{ seed, name, privateName?, locked, holders, device,\nindex, generation, ways: [{ id, factors: [{ kind, id?, name? }] }], origin?, birthday? }],\npasswords: [{ id, name, wallets }] }`. `device`: its holders give an unlock key, so a way\nmay take the device. Approvers."
  method unlock_wallet(params_json: tstr) -> tstr description "Unlock a wallet by one of its ways in: `{ seed, way, holder?, secret?, passwords? }`, or `{\nhandle, passwords }` to type a password again → `{ ok, state: \"done\" }`, or `{ ok, state:\n\"device\", handle }` while the holder works. `passwords` maps a password's id to it. Approvers."
  method unlock_progress(handle: tstr) -> tstr description "How a device step stands: `{ ok, state, seed, step?, code?, error? }`, `state` one of\n`device`, `needs_password`, `done`, `failed`. Approvers."
  method cancel_unlock(handle: tstr) -> bool description "Stop a device step: the holder stops asking. Approvers."
  method lock_wallets(params_json: tstr) -> tstr description "`{ seeds? }`, every wallet for `{}` → `{ ok, locked }`. Approvers."
  method set_rule(params_json: tstr) -> tstr description "A wallet's ways in: `{ seed, ways: [[factor]], holder?, secret?, passwords? }`, each factor\n`device` or `password:<id>` → as `unlock_wallet`. Approvers."
  method change_keys(params_json: tstr) -> tstr description "New keys for a wallet: `{ seed, newIndex?, holder?, secret?, passwords? }`; `newIndex: true`\nmoves to the next unlock key → as `unlock_wallet`. Approvers."
  method set_names(params_json: tstr) -> tstr description "`{ seed, name?, privateName? }` → `{ ok }`; an empty `privateName` clears it. Approvers."
  method create_password(params_json: tstr) -> tstr description "`{ name, password }` → `{ ok, id }`. Approvers."
  method rename_password(params_json: tstr) -> tstr description "`{ id, name }` → `{ ok }`. Approvers."
  method change_password(params_json: tstr) -> tstr description "`{ id, old, new }` → `{ ok }`. Approvers."
  method remove_password(params_json: tstr) -> tstr description "`{ id }` → `{ ok }`, refused while a wallet's rule takes it. Approvers."
  method accounts() -> tstr description "Every signer's accounts, each under the first signer that offers it: `{ ok, accounts: [{\nid, key, family, chain?, address?, label?, signer, available }] }`. No xpub: it would show a\nBitcoin wallet's whole history to anyone who asked. `key` is the account's `roster` key."
  method signers() -> tstr description "The signer modules consulted, with what each says it is: `{ ok, signers: [{ name, info? }] }`."
  method caller_identity() -> tstr description "What this module sees as its caller, with the roles and signers in force:\n`{ ok, kind, identity, approvers, custodians, signers }`."

  event approval_offered(handle: tstr) description "A new request is waiting."
  event approval_settled(handle: tstr, state: tstr) description "A request reached a terminal state."
  event approval_progress(handle: tstr, state: tstr) description "A request moved without settling, such as to `signing`."
  event accounts_changed(count: int) description "A signer's accounts changed; re-read `accounts`. `count` is advisory."
  event access_requested(handle: tstr) description "An open or unlock request is waiting for the custodian."
  event access_settled(handle: tstr, state: tstr) description "An open or unlock request reached a terminal state."
  event unlock_changed(account: tstr) description "An account was unlocked or locked."
  event signed_without_asking(handle: tstr) description "A request was signed without being shown, inside an unlock that allows it."
  event wallets_changed(seed: tstr) description "A wallet was added, unlocked or changed: re-read `wallets`, and ask `data_key` again."
  event wallets_locked(count: int) description "Wallets were locked: drop what was read under their keys."
}
